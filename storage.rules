rules_version = '2';

// Craft rules based on path in storage
// path format: /avatars/{uid}/filename or /company-logos/{uid}/filename
service firebase.storage {
  match /b/{bucket}/o {
    
    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // avatars logic
    match /avatars/{uid}/{allPaths=**} {
      // Anyone logged in can read avatars
      allow read: if request.auth != null;
      // Only the owner can write their own avatar
      allow write: if request.auth != null 
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024 // 5MB limit
                   && request.resource.contentType.matches('image/.*'); // Image only
    }

    // company-logos logic
    match /company-logos/{uid}/{allPaths=**} {
      // Anyone logged in can read logos
      allow read: if request.auth != null;
      // Only the owner can write their own logo
      allow write: if request.auth != null 
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024 // 5MB limit
                   && request.resource.contentType.matches('image/.*'); // Image only
    }
  }
}
