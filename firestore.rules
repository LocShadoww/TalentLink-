rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }

    // Function to get user data from the users collection
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Function to check if user has employer role
    function isEmployer() {
      return isAuthenticated() && getUserData().role == 'employer';
    }

    // Function to check if user has candidate role
    function isCandidate() {
      return isAuthenticated() && getUserData().role == 'candidate';
    }

    // Users Collection
    match /users/{userId} {
      // Anyone can create their own profile during signup
      allow create: if request.auth != null && request.auth.uid == userId;
      // Users can read and update their own profile
      // Allow others to read user profiles (e.g. employers viewing candidates, candidates viewing employer details)
      allow read: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false; // No deletion allowed currently
    }

    // Jobs Collection
    match /jobs/{jobId} {
      // Anyone can read active jobs
      allow read: if true;
      // Only employers can create jobs
      // They can only set employer_id to their own uid
      allow create: if isEmployer() && request.resource.data.employer_id == request.auth.uid;
      // Only the employer who created the job can update or delete it
      allow update, delete: if isEmployer() && resource.data.employer_id == request.auth.uid;
    }

    // Applications Collection
    match /applications/{applicationId} {
      // Candidates can read their own applications
      // Employers can read applications for their jobs
      allow read: if request.auth != null && (
        resource.data.candidate_id == request.auth.uid || 
        resource.data.employer_id == request.auth.uid
      );
      
      // Only candidates can create an application
      // Must set candidate_id to their own uid
      allow create: if isCandidate() && request.resource.data.candidate_id == request.auth.uid;
      
      // Candidates can delete (cancel) their applications
      // Employers can update (approve/reject) applications for their jobs
      allow update: if request.auth != null && resource.data.employer_id == request.auth.uid;
      allow delete: if request.auth != null && resource.data.candidate_id == request.auth.uid;
    }

    // Favorites Collection
    match /favorites/{favoriteId} {
      // Candidates can read their own favorites
      allow read: if request.auth != null && resource.data.candidate_id == request.auth.uid;
      // Only candidates can add favorites
      allow create: if isCandidate() && request.resource.data.candidate_id == request.auth.uid;
      // Only candidates can remove their favorites
      allow delete: if request.auth != null && resource.data.candidate_id == request.auth.uid;
      allow update: if false;
    }

    // Conversations Collection (for direct messaging)
    match /conversations/{conversationId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null && request.auth.uid in resource.data.participants;
    }

    // Messages Subcollection
    match /conversations/{conversationId}/messages/{messageId} {
      // Users can read messages in conversations they are part of
      allow read: if request.auth != null && 
                     request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      
      // Users can create messages in conversations they are part of
      allow create: if request.auth != null && 
                       request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants &&
                       request.resource.data.senderId == request.auth.uid;
                       
      // No updating or deleting messages for now
      allow update, delete: if false;
    }
  }
}
