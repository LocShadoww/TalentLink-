{
  "expo": {
    "name": "BT_NhatKyHT",
    "slug": "BT_NhatKyHT",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "btnhatkyht",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Ứng dụng cần sử dụng Camera để chụp ảnh đại diện và ảnh bài đăng.",
        "NSPhotoLibraryUsageDescription": "Ứng dụng cần truy cập Thư viện ảnh để bạn chọn ảnh tải lên.",
        "NSPhotoLibraryAddUsageDescription": "Ứng dụng cần lưu ảnh vào Thư viện ảnh của bạn."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Ứng dụng cần truy cập Thư viện ảnh để bạn chọn ảnh tải lên.",
          "cameraPermission": "Ứng dụng cần sử dụng Camera để chụp ảnh đại diện và ảnh bài đăng."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
